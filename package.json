{
  "name": "jaronlu.github.io",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "description": "Jaron Lu 的个人求职作品集站 — React + Tailwind CSS",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/build-agent-course.mjs",
    "build": "node scripts/build-agent-course.mjs && tsc -b && vite build && node scripts/prerender.mjs",
    "build:course": "node scripts/build-agent-course.mjs",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "verify:num": "node scripts/verify-numbers.mjs"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "marked": "^18.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
